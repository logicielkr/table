			 <param name="search" type="param" value="search" />
			 <param name="category" value="category" type="prop" />
			 <param name="project_id" value="project_id" type="prop" />
		</redirect>
	</query>
	<query id="category" funcType="query" label="Category 변경" auth="${prop.category_supported} equals 'true'">
		<commands>
			<command>
				<sql>
					update <entity>${prop.table_name}</entity> as graha_table set category = ?
					where graha_table_id = ?
<tile cond="${prop.authentication_type} equals 'login_name'">
						and graha_table.insert_id = ?
</tile>
<tile cond="${prop.authentication_type} equals 'role_name'">
						and exists (
							select *
							from <entity>${prop.user_role_table_name}</entity> _a
							inner join <entity>${prop.user_role_table_name}</entity> _b 
							on _a.<entity>${prop.role_name_column_name}</entity> = _b.<entity>${prop.role_name_column_name}</entity> and _b.<entity>${prop.login_name_column_name}</entity> = ?
							where _a.<entity>${prop.login_name_column_name}</entity> = graha_table.insert_id
						)
</tile>
				</sql>
				<params>
					<param name="category" datatype="varchar" value="prop.category" />
					<param name="graha_table_id" datatype="int" value="param.graha_table_id" />
					<param name="insert_id" datatype="varchar" value="prop.logined_user" cond="${prop.authentication_type} equals 'login_name'" />
					<param name="insert_id" datatype="varchar" value="prop.logined_user" cond="${prop.authentication_type} equals 'role_name'" />
				</params>
			</command>
		</commands>
		<redirect path="detail">
			 <param name="graha_table_id" type="param" value="graha_table_id" />
			 <param name="search" type="param" value="search" />
			 <param name="category" value="category" type="prop" />
			 <param name="project_id" value="project_id" type="prop" />
		</redirect>
	</query>
</querys>
